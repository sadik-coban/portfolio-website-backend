# api_v2 configuration — copy to .env locally, or set these as Railway env vars.
# NEVER commit real secrets. Rotate any key that has ever been shared/leaked.

# Persistent volume root. On Railway: mount a Volume at /data and set this to /data.
# Locally you can leave it unset (defaults to repo root) or point at a test dir.
VOLUME_DIR=/data

# Admin API (POST/DELETE /admin/*). Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# If ADMIN_API_KEY is empty, all /admin/* routes return 503 (disabled, fail-closed).
ADMIN_API_KEY=
# Optional comma-separated IP allowlist for /admin/* (empty => no IP restriction).
ADMIN_IP_ALLOWLIST=

# Railway S3 bucket — the curated serving store + model source for
# POST /admin/models/sync-s3 (S3 → volume). Managed by the admin_app HTML panel.
# Required for the admin model-sync AND the data-refresh poll below.
RAILWAY_S3_ENDPOINT=
RAILWAY_S3_ACCESS_KEY=
RAILWAY_S3_SECRET_KEY=
RAILWAY_S3_BUCKET=

# Data refresh — api_v2 polls a small S3 manifest and pulls a new cars.duckdb
# onto the volume (atomic swap) only when its version changes. No inbound
# endpoint (nothing to spam/steal). 0 disables the loop (data then only via the
# manual POST /admin/data/upload). Each tick is just a tiny manifest GET; the
# heavy cars.duckdb download happens once per version change.
DATA_SYNC_POLL_SECONDS=300
DATA_S3_KEY=data/cars.duckdb
DATA_MANIFEST_KEY=data/manifest.json
